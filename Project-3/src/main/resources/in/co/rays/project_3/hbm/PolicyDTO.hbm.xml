<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="PolicyDTO" table="ST_POLICY">

		<id name="policyId" type="java.lang.Long">
			<column name="POLICY_ID" />
			<generator class="increment" />
		</id>

		<property name="policyName" type="java.lang.String">
			<column name="POLICY_NAME" />
		</property>

		<property name="premiumAmount" type="java.lang.Long">
			<column name="PREMIUM_AMOUNT" />
		</property>

		<property name="startDate" type="java.util.Date">
			<column name="START_DATE" />
		</property>

	</class>

</hibernate-mapping>