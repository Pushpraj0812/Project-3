<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="TransformationDTO" table="ST_TRANSFORMATION">

		<id name="id" type="java.lang.Long">
			<column name="ID" />
			<generator class="increment" />
		</id>

		<property name="transformId" type="java.lang.Long">
			<column name="TRANSFORM_ID" />
		</property>

		<property name="transformCode" type="java.lang.String">
			<column name="TRANSFORM_CODE" />
		</property>

		<property name="ruleName" type="java.lang.String">
			<column name="RULE_NAME" />
		</property>

		<property name="logic" type="java.lang.String">
			<column name="LOGIC" />
		</property>

		<property name="status" type="java.lang.String">
			<column name="STATUS" />
		</property>

	</class>

</hibernate-mapping>