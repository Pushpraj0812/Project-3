<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="MediaCoverageDTO" table="ST_MEDIA_COVERAGE">

		<!-- Primary Key -->
		<id name="mediaCoverageId" type="java.lang.Long">
			<column name="MEDIA_COVERAGE_ID" />
			<generator class="increment" />
		</id>

		<!-- Fields -->
		<property name="mediaName" type="java.lang.String">
			<column name="MEDIA_NAME" />
		</property>

		<property name="coverageDate" type="java.util.Date">
			<column name="COVERAGE_DATE" />
		</property>

		<property name="reporter" type="java.lang.String">
			<column name="REPORTER" />
		</property>
	</class>

</hibernate-mapping>