<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="StockDTO" table="ST_STOCK">

		<id name="stockId" type="java.lang.Long">
			<column name="STOCK_ID" />
			<generator class="increment" />
		</id>

		<property name="stockName" type="java.lang.String">
			<column name="STOCK_NAME" />
		</property>

		<property name="price" type="java.lang.Long">
			<column name="PRICE" />
		</property>

		<property name="quantity" type="java.lang.Integer">
			<column name="QUANTITY" />
		</property>

	</class>

</hibernate-mapping>