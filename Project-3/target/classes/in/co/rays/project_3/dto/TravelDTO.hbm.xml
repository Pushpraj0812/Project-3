<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="TravelDTO" table="ST_TRAVEL">

		<id name="id" type="java.lang.Long">
			<column name="ID" />
			<generator class="increment" />
		</id>

		<property name="traveler_Name" type="java.lang.String">
			<column name="TRAVELER_NAME" />
		</property>

		<property name="Destination" type="java.lang.String">
			<column name="DESTINATION" />
		</property>

		<property name="start_Date" type="java.util.Date">
			<column name="START_DATE" />
		</property>

		<property name="end_Date" type="java.util.Date">
			<column name="END_DATE" />
		</property>

	</class>

</hibernate-mapping>