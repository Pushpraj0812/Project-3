<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="InsuranceDTO" table="ST_INSURANCE">

		<id name="id" type="java.lang.Long">
			<column name="INSURANCE_ID" />
			<generator class="increment" />
		</id>

		<property name="policyNumber" type="java.lang.String">
			<column name="POLICY_NUMBER" />
		</property>

		<property name="policyHolderName" type="java.lang.String">
			<column name="POLICY_HOLDER_NAME" />
		</property>

		<property name="expiryDate" type="java.util.Date">
			<column name="EXPIRY_DATE" />
		</property>

		<property name="insuranceStatus" type="java.lang.String">
			<column name="INSURANCE_STATUS" />
		</property>

	</class>

</hibernate-mapping>